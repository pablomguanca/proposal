{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "propuesta",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "require('http').createServer((q,r)=>{const p=require('path').join('.',q.url==='/'?'index.html':q.url);require('fs').readFile(p,(e,d)=>{if(e){r.writeHead(404);r.end()}else{const t={'.html':'text/html','.css':'text/css','.js':'application/javascript','.svg':'image/svg+xml'}[require('path').extname(p)]||'application/octet-stream';r.writeHead(200,{'Content-Type':t+';charset=utf-8'});r.end(d)}})}).listen(3456)"],
      "port": 3456
    }
  ]
}
